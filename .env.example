# ---- Meta WhatsApp Cloud API ----
# From developers.facebook.com > your app > WhatsApp > API Setup
META_ACCESS_TOKEN=your_meta_permanent_or_temp_token
META_PHONE_NUMBER_ID=your_phone_number_id
META_VERIFY_TOKEN=choose_any_random_string_here   # you set this, used during webhook verification
META_APP_SECRET=your_app_secret                   # used to verify incoming webhook signatures

# ---- Groq (free-text order parsing) ----
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Supabase ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key   # NOT the anon key — server-side only

# ---- Shop details ----
SHOP_NAME=Jay Fruit's
SHOP_UPI_ID=jayfruits@upi
SHOP_UPI_PAYEE_NAME=Jay Fruits
SHOP_WHATSAPP_DISPLAY_NUMBER=+91 99999 99999

# ---- Dashboard auth ----
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change_this_password
DASHBOARD_SECRET_KEY=change_this_to_a_long_random_string

# ---- v2 additions ----
# Public URL of this deployed app — used to build the customer's personal menu/
# order-history link (/me/<token>). Set to your Railway URL once deployed.
PUBLIC_BASE_URL=http://localhost:8000

# Rough delivery ETA quoted at order confirmation (minutes)
DEFAULT_DELIVERY_ETA_MINUTES=90

# Window within which a repeat order from the same customer is flagged as a
# possible accidental duplicate (minutes)
DUPLICATE_ORDER_WINDOW_MINUTES=5
